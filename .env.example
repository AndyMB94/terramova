# Plantilla de configuración local. `make env` crea .env a partir de este archivo y
# sustituye cada "change-me" por un valor aleatorio. .env nunca se versiona.
# No pongas aquí claves reales: este archivo es público.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# --- PostgreSQL ---
# Valores para procesos del host (tests, manage.py). Compose publica la base solo en
# 127.0.0.1:DB_PORT; dentro de Compose el backend usa db:5432.
DB_NAME=terramova
DB_USER=terramova
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433

# --- Redis ---
# Publicado solo en 127.0.0.1:REDIS_PORT; dentro de Compose el backend usa redis:6379.
REDIS_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0

# --- IA (docs/AI_SECURITY.md) ---
# Desactivada. No se añade ninguna clave de proveedor en desarrollo.
AI_ENABLED=false
