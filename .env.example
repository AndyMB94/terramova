# Plantilla de configuración local. `make env` crea .env a partir de este archivo y
# sustituye cada "change-me" por un valor aleatorio. .env nunca se versiona.
# No pongas aquí claves reales: este archivo es público.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# --- PostgreSQL ---
# Valores para procesos del host (tests, manage.py). Compose publica la base solo en
# 127.0.0.1:DB_PORT; dentro de Compose el backend usa db:5432.
DB_NAME=terramova
DB_USER=terramova
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433

# --- Redis ---
# Publicado solo en 127.0.0.1:REDIS_PORT; dentro de Compose el backend usa redis:6379.
REDIS_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0

# Límite de duración de cualquier consulta SQL (ms).
DB_STATEMENT_TIMEOUT_MS=15000

# --- API pública ---
# Límites de tasa (DRF): por IP y global. Las variantes _FALLBACK se aplican por proceso
# si Redis no responde. API_NUM_PROXIES: 0 en desarrollo, 1 detrás de Nginx.
API_THROTTLE_PER_IP=120/min
API_THROTTLE_PER_IP_FALLBACK=30/min
API_THROTTLE_GLOBAL=3000/min
API_THROTTLE_GLOBAL_FALLBACK=600/min
API_NUM_PROXIES=0

# --- IA (docs/AI_SECURITY.md) ---
# Desactivada. No se añade ninguna clave de proveedor en desarrollo.
AI_ENABLED=false
