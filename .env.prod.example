# Plantilla del .env de PRODUCCIÓN (en el VPS, en /root/terramova/.env, permisos 600).
# Nunca se versiona el archivo real. Genera cada secreto con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# (Django exige una SECRET_KEY de 50 caracteres o más; check --deploy lo comprueba.)

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=terramova.andymallcco.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://terramova.andymallcco.dev
# Ruta del admin: algo no adivinable, terminado en "/". Nginx solo la expone con
# contraseña adicional (infra/nginx/terramova.andymallcco.dev.conf).
DJANGO_ADMIN_URL=

DB_NAME=terramova
DB_USER=terramova
DB_PASSWORD=

REDIS_PASSWORD=
REDIS_DB=0

# Workers de Gunicorn: se fijan con el inventario del VPS (compartido con otros proyectos).
WEB_CONCURRENCY=2

DB_STATEMENT_TIMEOUT_MS=15000
API_THROTTLE_PER_IP=120/min
API_THROTTLE_PER_IP_FALLBACK=30/min
API_THROTTLE_GLOBAL=3000/min
API_THROTTLE_GLOBAL_FALLBACK=600/min

# IA desactivada (Fase 5 aplazada, D112). No hay ninguna clave de proveedor.
AI_ENABLED=false
